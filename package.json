    "verify-cloud-sync": "node --import tsx scripts/verify-cloud-sync.ts",
    "verify-class-foundation": "node --import tsx scripts/verify-class-foundation.ts",
    "verify-class-detection": "node --import tsx scripts/verify-class-detection.ts",
    "verify-class-management": "node --import tsx scripts/verify-class-management.ts",
    "verify-class-rendering": "node --import tsx scripts/verify-class-rendering.ts",
    "verify-stage6": "node --import tsx scripts/verify-stage6.ts",
